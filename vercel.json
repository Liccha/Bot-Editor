{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/fonts/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/fonts/:path*"
    },
    {
      "source": "/api/design/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/design/:path*"
    },
    {
      "source": "/api/mcz/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/mcz/:path*"
    },
    {
      "source": "/api/excel/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/excel/:path*"
    },
    {
      "source": "/api/blog/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/blog/:path*"
    },
    {
      "source": "/api/admin/:path*",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/admin/:path*"
    },
    {
      "source": "/api/visit",
      "destination": "https://win-mohsfa7n4b0.tailae715d.ts.net/api/visit"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/bg.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
